name: Hesabdari Moshtarak V13 APK

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Check source ZIP
        run: |
          ls -lah
          test -f HesabdariMoshtarak_v8_professional_sync_ready_FIXED.zip

      - name: Extract project
        run: |
          rm -rf project
          mkdir -p project
          unzip -o HesabdariMoshtarak_v8_professional_sync_ready_FIXED.zip -d project

      - name: Verify project
        run: |
          test -f project/settings.gradle.kts
          test -f project/app/build.gradle.kts
          test -f project/app/google-services.json

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Gradle 8.7
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.7'

      - name: Build APK
        working-directory: project
        run: gradle assembleDebug --stacktrace

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: HesabdariMoshtarak-V13-APK
          path: project/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
